{
  "id": "html",
  "name": "HTML",
  "version": 1,
  "extensions": ["html", "htm", "xhtml"],
  "firstLine": "(?i)^<!doctype html",
  "blockComment": ["<!--", "-->"],
  "rules": [
    {"scope": "comment", "begin": "<!--", "end": "-->"},
    {"scope": "string", "match": "<!\\[CDATA\\[[\\s\\S]*?(?:\\]\\]>|\\z)"},
    {"scope": "keyword", "match": "<![A-Za-z][^>]*>|<\\?[\\w-]+|\\?>"},
    {"scope": "tag", "match": "</?[A-Za-z_][\\w:.-]*|/?>"},
    {"scope": "attribute", "match": "(?<=\\s)[A-Za-z_:@][\\w:.@-]*(?=\\s*=)"},
    {"scope": "string", "match": "(?<==)\"[^\"]*\"|(?<==)'[^']*'"},
    {"scope": "constant", "match": "&[#\\w]+;"}
  ]
}
