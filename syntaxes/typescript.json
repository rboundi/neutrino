{
  "id": "typescript",
  "name": "TypeScript",
  "version": 1,
  "extensions": ["ts", "tsx", "mts", "cts"],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "rules": [
    {"scope": "comment", "match": "//.*"},
    {"scope": "comment", "begin": "/\\*", "end": "\\*/"},
    {"scope": "string", "begin": "`", "end": "`", "escape": "\\\\"},
    {"scope": "string", "begin": "\"", "end": "\"", "escape": "\\\\", "multiline": false},
    {"scope": "string", "begin": "'", "end": "'", "escape": "\\\\", "multiline": false},
    {"scope": "attribute", "match": "@\\w+"},
    {"scope": "keyword", "words": ["as", "async", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "export", "extends", "finally", "for", "from", "function", "get", "if", "import", "in", "instanceof", "let", "new", "of", "return", "set", "static", "switch", "throw", "try", "typeof", "var", "void", "while", "with", "yield", "abstract", "accessor", "asserts", "declare", "enum", "implements", "infer", "interface", "is", "keyof", "module", "namespace", "out", "override", "private", "protected", "public", "readonly", "satisfies", "type", "unique"]},
    {"scope": "constant", "words": ["true", "false", "null", "undefined", "NaN", "Infinity", "this", "super", "arguments", "globalThis"]},
    {"scope": "type", "words": ["any", "bigint", "boolean", "never", "number", "object", "string", "symbol", "unknown", "void"]},
    {"scope": "type", "match": "\\b[A-Z]\\w*\\b"},
    {"scope": "number", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b|\\b\\d+n\\b"},
    {"scope": "function", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
  ]
}
