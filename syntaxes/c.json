{
  "id": "c",
  "name": "C",
  "version": 2,
  "extensions": ["c", "h"],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "symbols": ["^[A-Za-z_][\\w \\t*]*?[ \\t*]([A-Za-z_]\\w*)[ \\t]*\\([^;{}\\n]*\\)[ \\t]*\\{?[ \\t]*$", "^(?:typedef[ \\t]+)?(?:struct|enum|union)[ \\t]+(\\w+)[ \\t]*\\{"],
  "rules": [
    {"scope": "comment", "match": "//.*"},
    {"scope": "comment", "begin": "/\\*", "end": "\\*/"},
    {"scope": "string", "match": "(?<=#include )<[^>\\n]+>"},
    {"scope": "string", "begin": "\"", "end": "\"", "escape": "\\\\", "multiline": false},
    {"scope": "string", "begin": "'", "end": "'", "escape": "\\\\", "multiline": false},
    {"scope": "keyword", "match": "^[ \\t]*#[ \\t]*\\w+"},
    {"scope": "keyword", "words": ["auto", "break", "case", "const", "continue", "default", "do", "else", "enum", "extern", "for", "goto", "if", "inline", "register", "restrict", "return", "sizeof", "static", "struct", "switch", "typedef", "union", "volatile", "while", "_Alignas", "_Alignof", "_Atomic", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local"]},
    {"scope": "type", "words": ["bool", "char", "double", "float", "int", "long", "short", "signed", "unsigned", "void", "size_t", "ssize_t", "ptrdiff_t", "wchar_t", "FILE"]},
    {"scope": "type", "match": "\\b\\w+_t\\b"},
    {"scope": "constant", "words": ["NULL", "true", "false"]},
    {"scope": "number", "match": "\\b(?:0[xX][0-9a-fA-F']+|0[bB][01']+|\\d[\\d']*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)[uUlLfFdD]*\\b"},
    {"scope": "function", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
  ]
}
