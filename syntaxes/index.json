{
  "syntaxes": [
    {"id": "c", "name": "C", "version": 2, "extensions": ["c", "h"]},
    {"id": "csharp", "name": "C#", "version": 2, "extensions": ["cs", "csx"]},
    {"id": "cpp", "name": "C++", "version": 2, "extensions": ["cpp", "cc", "cxx", "hpp", "hh", "hxx", "ino"]},
    {"id": "css", "name": "CSS", "version": 2, "extensions": ["css", "scss", "less"]},
    {"id": "diff", "name": "Diff", "version": 2, "extensions": ["diff", "patch"]},
    {"id": "dockerfile", "name": "Dockerfile", "version": 2, "extensions": ["dockerfile"], "filenames": ["Dockerfile", "Containerfile"]},
    {"id": "go", "name": "Go", "version": 2, "extensions": ["go"]},
    {"id": "html", "name": "HTML", "version": 2, "extensions": ["html", "htm", "xhtml"], "firstLine": "(?i)^<!doctype html"},
    {"id": "ini", "name": "INI", "version": 2, "extensions": ["ini", "cfg", "conf", "properties", "desktop"], "filenames": [".editorconfig", ".gitconfig", ".npmrc"]},
    {"id": "java", "name": "Java", "version": 2, "extensions": ["java"]},
    {"id": "javascript", "name": "JavaScript", "version": 2, "extensions": ["js", "mjs", "cjs", "jsx"], "firstLine": "^#!.*\\b(?:node|deno|bun)\\b"},
    {"id": "json", "name": "JSON", "version": 1, "extensions": ["json", "jsonc", "json5", "webmanifest", "geojson"], "filenames": [".prettierrc", ".eslintrc", ".babelrc", "Package.resolved"]},
    {"id": "kotlin", "name": "Kotlin", "version": 2, "extensions": ["kt", "kts"]},
    {"id": "lua", "name": "Lua", "version": 2, "extensions": ["lua"]},
    {"id": "makefile", "name": "Makefile", "version": 2, "extensions": ["mk", "mak"], "filenames": ["Makefile", "makefile", "GNUmakefile"]},
    {"id": "markdown", "name": "Markdown", "version": 2, "extensions": ["md", "markdown", "mdown", "mkd", "mdx"]},
    {"id": "php", "name": "PHP", "version": 2, "extensions": ["php", "phtml"]},
    {"id": "python", "name": "Python", "version": 3, "extensions": ["py", "pyw", "pyi"], "filenames": ["SConstruct", "wscript"], "firstLine": "^#!.*\\bpython"},
    {"id": "ruby", "name": "Ruby", "version": 2, "extensions": ["rb", "rake", "gemspec", "ru"], "filenames": ["Gemfile", "Rakefile", "Podfile", "Fastfile", "Brewfile", "Vagrantfile"], "firstLine": "^#!.*\\bruby"},
    {"id": "rust", "name": "Rust", "version": 2, "extensions": ["rs"]},
    {"id": "shell", "name": "Shell", "version": 2, "extensions": ["sh", "bash", "zsh", "ksh", "command"], "filenames": [".zshrc", ".bashrc", ".bash_profile", ".zprofile", ".profile", ".zshenv"], "firstLine": "^#!.*\\b(?:ba|z|k|da)?sh\\b"},
    {"id": "sql", "name": "SQL", "version": 2, "extensions": ["sql"]},
    {"id": "swift", "name": "Swift", "version": 2, "extensions": ["swift"]},
    {"id": "toml", "name": "TOML", "version": 2, "extensions": ["toml"], "filenames": ["Cargo.lock", "Pipfile", "uv.lock", "poetry.lock"]},
    {"id": "typescript", "name": "TypeScript", "version": 2, "extensions": ["ts", "tsx", "mts", "cts"]},
    {"id": "xml", "name": "XML", "version": 1, "extensions": ["xml", "plist", "svg", "xsd", "xsl", "xslt", "rss", "atom", "storyboard", "xib", "entitlements"], "firstLine": "^<\\?xml"},
    {"id": "yaml", "name": "YAML", "version": 3, "extensions": ["yaml", "yml"], "filenames": [".clang-format", ".clang-tidy"]}
  ]
}
