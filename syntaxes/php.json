{
  "id": "php",
  "name": "PHP",
  "version": 1,
  "extensions": ["php", "phtml"],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "rules": [
    {"scope": "comment", "match": "//.*"},
    {"scope": "comment", "match": "#(?!\\[).*"},
    {"scope": "comment", "begin": "/\\*", "end": "\\*/"},
    {"scope": "string", "begin": "\"", "end": "\"", "escape": "\\\\"},
    {"scope": "string", "begin": "'", "end": "'", "escape": "\\\\"},
    {"scope": "keyword", "match": "<\\?php|<\\?=|\\?>"},
    {"scope": "variable", "match": "\\$\\w+"},
    {"scope": "keyword", "words": ["abstract", "and", "as", "break", "callable", "case", "catch", "class", "clone", "const", "continue", "declare", "default", "do", "echo", "else", "elseif", "empty", "enddeclare", "endfor", "endforeach", "endif", "endswitch", "endwhile", "enum", "extends", "final", "finally", "fn", "for", "foreach", "function", "global", "goto", "if", "implements", "include", "include_once", "instanceof", "insteadof", "interface", "isset", "list", "match", "namespace", "new", "or", "print", "private", "protected", "public", "readonly", "require", "require_once", "return", "static", "switch", "throw", "trait", "try", "unset", "use", "var", "while", "xor", "yield"]},
    {"scope": "constant", "words": ["true", "false", "null", "TRUE", "FALSE", "NULL", "self", "parent"]},
    {"scope": "type", "words": ["array", "bool", "float", "int", "iterable", "mixed", "never", "object", "string", "void"]},
    {"scope": "type", "match": "\\b[A-Z]\\w*\\b"},
    {"scope": "number", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b"},
    {"scope": "function", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
  ]
}
