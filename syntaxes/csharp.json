{
  "id": "csharp",
  "name": "C#",
  "version": 2,
  "extensions": ["cs", "csx"],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "symbols": ["^[ \\t]*(?:[\\w\\[\\]]+[ \\t]+)*(?:class|interface|enum|record|struct|namespace)[ \\t]+([\\w.]+)", "^[ \\t]+(?:(?:public|private|protected|internal|static|virtual|override|abstract|async|sealed)[ \\t]+)+[\\w<>\\[\\],.? ]+[ \\t]+(\\w+)[ \\t]*\\("],
  "rules": [
    {"scope": "comment", "match": "//.*"},
    {"scope": "comment", "begin": "/\\*", "end": "\\*/"},
    {"scope": "string", "match": "\\$?@\\$?\"(?:\"\"|[^\"])*\""},
    {"scope": "string", "begin": "\\$?\"", "end": "\"", "escape": "\\\\", "multiline": false},
    {"scope": "string", "begin": "'", "end": "'", "escape": "\\\\", "multiline": false},
    {"scope": "keyword", "match": "^[ \\t]*#[ \\t]*\\w+"},
    {"scope": "keyword", "words": ["abstract", "as", "async", "await", "base", "break", "case", "catch", "checked", "class", "const", "continue", "default", "delegate", "do", "else", "enum", "event", "explicit", "extern", "finally", "fixed", "for", "foreach", "get", "goto", "if", "implicit", "in", "init", "interface", "internal", "is", "lock", "namespace", "new", "operator", "out", "override", "params", "partial", "private", "protected", "public", "readonly", "record", "ref", "required", "return", "sealed", "set", "sizeof", "stackalloc", "static", "struct", "switch", "throw", "try", "typeof", "unchecked", "unsafe", "using", "var", "virtual", "volatile", "when", "where", "while", "yield"]},
    {"scope": "type", "words": ["bool", "byte", "char", "decimal", "double", "dynamic", "float", "int", "long", "nint", "nuint", "object", "sbyte", "short", "string", "uint", "ulong", "ushort", "void"]},
    {"scope": "constant", "words": ["true", "false", "null", "this", "value"]},
    {"scope": "type", "match": "\\b[A-Z]\\w*\\b"},
    {"scope": "number", "match": "\\b(?:0[xX][0-9a-fA-F']+|0[bB][01']+|\\d[\\d']*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)[uUlLfFdD]*\\b"},
    {"scope": "function", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
  ]
}
