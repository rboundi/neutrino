{
  "id": "python",
  "name": "Python",
  "version": 1,
  "extensions": ["py", "pyw", "pyi"],
  "filenames": ["SConstruct", "wscript"],
  "firstLine": "^#!.*\\bpython",
  "lineComment": "#",
  "rules": [
    {"scope": "comment", "match": "#.*"},
    {"scope": "string", "begin": "(?i:\\b[rbfu]{1,2})?\"\"\"", "end": "\"\"\"", "escape": "\\\\"},
    {"scope": "string", "begin": "(?i:\\b[rbfu]{1,2})?'''", "end": "'''", "escape": "\\\\"},
    {"scope": "string", "begin": "(?i:\\b[rbfu]{1,2})?\"", "end": "\"", "escape": "\\\\", "multiline": false},
    {"scope": "string", "begin": "(?i:\\b[rbfu]{1,2})?'", "end": "'", "escape": "\\\\", "multiline": false},
    {"scope": "attribute", "match": "^[ \\t]*@[\\w.]+"},
    {"scope": "function", "match": "(?<=\\bdef )\\w+"},
    {"scope": "type", "match": "(?<=\\bclass )\\w+"},
    {"scope": "keyword", "words": ["and", "as", "assert", "async", "await", "break", "case", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "match", "nonlocal", "not", "or", "pass", "raise", "return", "try", "type", "while", "with", "yield"]},
    {"scope": "constant", "words": ["True", "False", "None", "self", "cls", "NotImplemented", "Ellipsis", "__name__", "__main__"]},
    {"scope": "number", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[jJ]?)\\b"},
    {"scope": "function", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
  ]
}
